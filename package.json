{
  "name": "photo-pigeon",
  "version": "0.1.1",
  "description": "Back up photos to Google Photos automatically on Windows: watch a folder, auto upload every new photo, no browser tab open",
  "keywords": [
    "google-photos",
    "photo-backup",
    "auto-upload",
    "backup",
    "upload",
    "uploader",
    "sync",
    "watch-folder",
    "folder-watcher",
    "photos",
    "windows",
    "tray",
    "desktop",
    "cli",
    "drive-for-desktop",
    "drive-for-desktop-replacement"
  ],
  "type": "module",
  "bin": {
    "photo-pigeon": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "Alexander Yermakov (justerlex)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justerlex/photo-pigeon.git"
  },
  "homepage": "https://github.com/justerlex/photo-pigeon#readme",
  "bugs": {
    "url": "https://github.com/justerlex/photo-pigeon/issues"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chokidar": "^4.0.3",
    "commander": "^15.0.0",
    "google-auth-library": "^10.9.1",
    "open": "^11.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
